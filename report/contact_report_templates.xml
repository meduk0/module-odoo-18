<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Template principal pour le rapport détaillé des contacts -->
    <template id="contact_report_template">
        <t t-call="web.external_layout">
            <div class="page">
                <!-- En-tête du rapport -->
                <div class="row mb32">
                    <div class="col-8">
                        <h1 class="text-primary">📋 Rapport des Contacts</h1>
                    </div>
                    <div class="col-4 text-right">
                        <p>
                            <strong>Date du rapport :</strong>
                            <span t-esc="datetime.datetime.now().strftime('%d/%m/%Y')"/>
                        </p>
                        <p>
                            <strong>Nombre de contacts :</strong>
                            <span t-esc="len(docs)"/>
                        </p>
                    </div>
                </div>

                <!-- Tableau principal des contacts -->
                <h2 class="mb16">Liste des contacts</h2>
                <table class="table table-striped table-sm mt16">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 30%;">Nom</th>
                            <th style="width: 25%;">Email</th>
                            <th style="width: 20%;">Téléphone</th>
                            <th style="width: 25%;">Catégorie</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="contact">
                            <tr>
                                <td><strong t-esc="contact.name"/></td>
                                <td><span t-esc="contact.email or '-'"/></td>
                                <td><span t-esc="contact.phone or '-'"/></td>
                                <td>
                                    <t t-if="contact.category_id">
                                        <span class="badge badge-info" t-esc="contact.category_id.name"/>
                                    </t>
                                    <t t-else="">
                                        <span class="badge badge-secondary">Sans catégorie</span>
                                    </t>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- Détails complets des contacts -->
                <div class="mt32">
                    <h2 class="mb16">Détails complets des contacts</h2>
                    <t t-foreach="docs" t-as="contact">
                        <div class="page-break-before mb32 p-3" style="border: 1px solid #ddd; border-radius: 5px;">
                            <div class="row">
                                <div class="col-8">
                                    <h3 t-esc="contact.name" class="text-primary"/>
                                    <p class="text-muted">
                                        <strong>Catégorie :</strong>
                                        <t t-if="contact.category_id">
                                            <span t-esc="contact.category_id.name"/>
                                        </t>
                                        <t t-else="">Sans catégorie</t>
                                    </p>
                                </div>
                            </div>
                            <hr/>
                            <div class="row">
                                <div class="col-6">
                                    <p>
                                        <strong>📧 Email :</strong><br/>
                                        <span t-esc="contact.email or 'Non disponible'"/>
                                    </p>
                                    <p>
                                        <strong>📞 Téléphone :</strong><br/>
                                        <span t-esc="contact.phone or 'Non disponible'"/>
                                    </p>
                                </div>
                                <div class="col-6">
                                    <p>
                                        <strong>📍 Adresse :</strong><br/>
                                        <span t-esc="contact.address or 'Non disponible'"/>
                                    </p>
                                </div>
                            </div>

                            <!-- Section Relations si disponibles -->
                            <t t-if="contact.related_contact_ids">
                                <hr/>
                                <div class="row mt16">
                                    <div class="col-12">
                                        <h4>🔗 Contacts liés</h4>
                                        <ul>
                                            <t t-foreach="contact.related_contact_ids" t-as="related">
                                                <li>
                                                    <span t-esc="related.name"/>
                                                    <t t-if="related.category_id">
                                                        <span class="badge badge-light" t-esc="'(' + related.category_id.name + ')'"/>
                                                    </t>
                                                </li>
                                            </t>
                                        </ul>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>

                <!-- Résumé des statistiques -->
                <div class="mt32 p-3" style="background-color: #f8f9fa; border-radius: 5px;">
                    <h3>📊 Résumé statistique</h3>
                    <ul>
                        <li><strong>Nombre total de contacts :</strong> <span t-esc="len(docs)"/></li>
                        <li>
                            <strong>Contacts avec catégorie :</strong>
                            <span t-esc="len([c for c in docs if c.category_id])"/>
                        </li>
                        <li>
                            <strong>Contacts sans catégorie :</strong>
                            <span t-esc="len([c for c in docs if not c.category_id])"/>
                        </li>
                    </ul>
                </div>
            </div>
        </t>
    </template>

    <!-- Rapport PDF des contacts -->
    <record id="action_report_contacts" model="ir.actions.report">
        <field name="name">📄 Rapport des Contacts (PDF)</field>
        <field name="model">mon_module.contact</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mon_module.contact_report_template</field>
        <field name="report_file">mon_module.contact_report_template</field>
        <field name="binding_model_id" ref="model_mon_module_contact"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
