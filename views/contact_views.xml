<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Vue en liste pour les contacts avec options avancées -->
    <record id="view_contact_tree" model="ir.ui.view">
        <field name="name">mon_module.contact.tree</field>
        <field name="model">mon_module.contact</field>
        <field name="arch" type="xml">
            <list string="Contacts" editable="bottom" decoration-bf="name">
                <field name="name" string="Nom" />
                <field name="category_id" string="Catégorie" widget="many2one" optional="show"/>
                <field name="email" string="Email" optional="show"/>
                <field name="phone" string="Téléphone" optional="show"/>
                <button name="action_print_contacts" type="object" string="PDF" class="btn btn-sm btn-primary" icon="fa-file-pdf-o" title="Exporter en PDF"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire pour les contacts améliorée -->
    <record id="view_contact_form" model="ir.ui.view">
        <field name="name">mon_module.contact.form</field>
        <field name="model">mon_module.contact</field>
        <field name="arch" type="xml">
            <form string="Contact">
                <header>
                    <button name="action_save_and_close" type="object" string="💾 Sauvegarder &amp; Retour" class="oe_highlight"/>
                    <button name="action_cancel" type="object" string="❌ Annuler" class="btn-secondary"/>
                    <button name="action_print_contacts" type="object" string="📄 Exporter PDF" class="btn-info"/>
                </header>
                <sheet>
                    <!-- Section Informations générales -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom du contact" class="o_input"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id" string="Catégorie" options="{'no_create_edit': True}"/>
                            <field name="email" string="Adresse Email" widget="email"/>
                            <field name="phone" string="Téléphone" widget="phone"/>
                        </group>
                        <group>
                            <field name="address" string="Adresse" placeholder="Adresse complète..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contacts liés">
                            <field name="related_contact_ids" widget="many2many_tags" placeholder="Ajouter des contacts..." options="{'no_create': 1}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue de recherche pour les contacts -->
    <record id="view_contact_search" model="ir.ui.view">
        <field name="name">mon_module.contact.search</field>
        <field name="model">mon_module.contact</field>
        <field name="arch" type="xml">
            <search string="Recherche Contacts">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="category_id"/>
                <group expand="0" string="Group By">
                    <filter string="Catégorie" name="group_by_category" context="{'group_by':'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vue Kanban pour les contacts -->
    <record id="view_contact_kanban" model="ir.ui.view">
        <field name="name">mon_module.contact.kanban</field>
        <field name="model">mon_module.contact</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id">
                <field name="name"/>
                <field name="email"/>
                <field name="category_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div t-if="record.email.value">
                                    <field name="email"/>
                                </div>
                                <div t-if="record.category_id.value">
                                    <span class="badge badge-primary"><field name="category_id"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action pour ouvrir les vues contact -->
    <record id="action_contact" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="res_model">mon_module.contact</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- Menu principal pour la gestion des contacts -->
    <menuitem id="menu_mon_module_root" name="Gestion Contacts" sequence="10"/>
    <!-- Menu pour accéder aux contacts -->
    <menuitem id="menu_mon_module_contacts" name="Contacts" parent="menu_mon_module_root" action="action_contact" sequence="10"/>

    <!-- Vue en liste pour les catégories améliorée -->
    <record id="view_contact_category_tree" model="ir.ui.view">
        <field name="name">mon_module.contact.category.tree</field>
        <field name="model">mon_module.contact.category</field>
        <field name="arch" type="xml">
            <list string="Catégories de contacts" editable="bottom">
                <field name="name" string="Nom de la catégorie" width="40%"/>
                <field name="description" string="Description" width="60%" widget="text"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire pour les catégories améliorée -->
    <record id="view_contact_category_form" model="ir.ui.view">
        <field name="name">mon_module.contact.category.form</field>
        <field name="model">mon_module.contact.category</field>
        <field name="arch" type="xml">
            <form string="Catégorie de contact">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la catégorie" class="o_input"/>
                        </h1>
                    </div>
                    <group string="Détails" col="1">
                        <field name="description" placeholder="Décrivez cette catégorie..." nolabel="True" rows="6"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_contact_category" model="ir.actions.act_window">
        <field name="name">Catégories</field>
        <field name="res_model">mon_module.contact.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mon_module_categories" name="Catégories" parent="menu_mon_module_root" action="action_contact_category" sequence="20"/>
</odoo>
